# ============================================
# PROXVEL Backend - Variables Docker (activas)
# ============================================

# Configuración de la aplicación
APP_ENV=development
APP_NAME=PROXVEL Backend
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT — Obligatorio. Rotar invalida sesiones activas.
SECRET_KEY=proxvel_docker_dev_secret_f8a2c9e7b1d4

# PostgreSQL
POSTGRES_USER=proxvel_user
POSTGRES_PASSWORD=proxvel_password
POSTGRES_DB=proxvel_db

# URL de conexión (usar 'postgres' como host dentro de Docker)
DATABASE_URL=postgresql://proxvel_user:proxvel_password@postgres:5432/proxvel_db

# ============================================
# PROXVEL Backend - Variables Docker
# Copiar a .env.docker y ajustar valores
# ============================================

# Configuración de la aplicación
APP_ENV=development
APP_NAME=PROXVEL Backend
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT — OBLIGATORIO. Generar un secreto único y privado.
# Rotar SECRET_KEY invalida sesiones activas y fuerza re-login.
SECRET_KEY=change_me_generate_a_secure_random_value

# PostgreSQL
POSTGRES_USER=proxvel_user
POSTGRES_PASSWORD=proxvel_password
POSTGRES_DB=proxvel_db

# URL de conexión (usar 'postgres' como host dentro de Docker)
DATABASE_URL=postgresql://proxvel_user:proxvel_password@postgres:5432/proxvel_db

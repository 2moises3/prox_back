# Entorno de ejecución (development, production)
APP_ENV=development
ACCOUNT_DELETION_GRACE_DAYS=14

# Configuración de base de datos
# Reemplazar placeholders en el archivo .env local
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database_name>

# CORS - orígenes permitidos separados por coma. NO usar "*" en producción,
# especialmente junto con credenciales (cookies/JWT en headers).
# Flutter móvil no depende de CORS; el dashboard web sí.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Config — OBLIGATORIO fijar un valor propio en .env real.
# El backend NO arrancará sin esta variable definida.
# Rotar SECRET_KEY invalida todas las sesiones activas y fuerza re-login.
SECRET_KEY=change_me_generate_a_secure_random_value
ALGORITHM=HS256
# Viajero (app móvil, sin refresh token): 14 días. Admin/super_admin (dashboard): 8 horas.
ACCESS_TOKEN_EXPIRE_MINUTES=20160
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Password Hashing
PASSWORD_HASH_SCHEME=bcrypt
BCRYPT_ROUNDS=12

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=proxvel/destinations
MAX_UPLOAD_SIZE_MB=5

# --- Seguridad -------------------------------------------------------------
# Con APP_ENV=production el backend NO arranca si: CORS_ORIGINS contiene "*" o está
# vacío, DEBUG=True, SECRET_KEY tiene menos de 32 caracteres o es un valor de ejemplo,
# o falta DATABASE_URL.
# DEBUG recarga el código automáticamente: solo para desarrollo local.
DEBUG=False
# Muestra las consultas SQL en el log (muy verboso).
SQL_ECHO=False
# Swagger (/docs): visible en desarrollo; en producción solo con ENABLE_DOCS=true.
# ENABLE_DOCS=true
# Activar SOLO detrás de un proxy de confianza (Railway): usa X-Forwarded-For como IP real.
TRUST_PROXY_HEADERS=False
# Límite de intentos: fallos de login por correo+IP, por IP, ventana (s) y registros por IP/hora.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_PER_IP=10

# --- Recuperar contraseña por correo ---------------------------------------
# console = no envía nada: el código sale en el log del backend (solo desarrollo).
# smtp    = envío real. En producción (APP_ENV=production) es obligatorio.
EMAIL_BACKEND=console
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu@gmail.com,
# SMTP_PASSWORD=<contraseña de aplicación de 16 letras>, SMTP_FROM="PROXVEL <tu@gmail.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
SMTP_USE_TLS=True
# Correo que la app muestra si el código no llega (puede quedar vacío).
SUPPORT_EMAIL=soporte@m3biznovatech.com
PASSWORD_RESET_CODE_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_PER_EMAIL=3
PASSWORD_RESET_PER_IP=10
